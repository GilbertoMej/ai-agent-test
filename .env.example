# --- Required for both Next.js and worker ---
# Postgres connection string with pgvector extension available.
# Format: postgres://<user>:<pass>@<host>:<port>/<db>
DATABASE_URL=

# Shared secret the Next.js side sends as `Authorization: Bearer <value>`
# to every worker call. Generate with: openssl rand -hex 32
WORKER_SHARED_SECRET=

# Where the worker listens. Default below is fine for local dev.
WORKER_URL=http://localhost:4111

# --- Agent model (D-02: OpenRouter Nemotron 3 Ultra free) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- InsForge model gateway (D-03, D-04) ---
# Used for embeddings + InsForge-side helpers. Never called by the agent loop.
INSFORGE_BASE_URL=
INSFORGE_SERVICE_KEY=

# --- Embedding model (InsForge-side) ---
# Default: OpenAI small embeddings via the InsForge gateway (1536 dims).
EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIMS=1536

# --- Worker boot ---
WORKER_PORT=4111
